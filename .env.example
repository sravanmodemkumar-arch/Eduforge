# =============================================================================
# EduForge Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=eduforge
POSTGRES_PASSWORD=eduforge_secret
POSTGRES_DB=eduforge
DATABASE_URL=postgresql+asyncpg://eduforge:eduforge_secret@localhost:5432/eduforge

# -----------------------------------------------------------------------------
# JWT / Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Django (Portal Service)
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=portal.settings

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8002,http://localhost:3000

# -----------------------------------------------------------------------------
# Cloudflare R2 (Object Storage)
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=eduforge-assets
CLOUDFLARE_R2_PUBLIC_URL=https://assets.eduforge.io

# -----------------------------------------------------------------------------
# Razorpay (Payments)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# -----------------------------------------------------------------------------
# WhatsApp (Notifications)
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# -----------------------------------------------------------------------------
# MSG91 (SMS)
# -----------------------------------------------------------------------------
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=EDUFGE
MSG91_TEMPLATE_ID=your-msg91-template-id
MSG91_OTP_TEMPLATE_ID=your-msg91-otp-template-id

# -----------------------------------------------------------------------------
# SendGrid (Email)
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@eduforge.io
SENDGRID_FROM_NAME=EduForge

# -----------------------------------------------------------------------------
# AWS (SQS, Lambda, ECS)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566

# SQS Queue URLs
SQS_EXAM_QUEUE_URL=http://localhost:4566/000000000000/exam-events
SQS_NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/notification-events
SQS_BILLING_QUEUE_URL=http://localhost:4566/000000000000/billing-events
SQS_AI_QUEUE_URL=http://localhost:4566/000000000000/ai-events
SQS_ANALYTICS_QUEUE_URL=http://localhost:4566/000000000000/analytics-events

# -----------------------------------------------------------------------------
# OpenAI (AI Service)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
